---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/site';
---

<section id="skills" class="border-t border-zinc-200 py-24 dark:border-zinc-900">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading index="02" title="Skill & teknologi" />

    <div class="grid gap-6 md:grid-cols-3">
      {
        skills.map((group) => (
          <div class="reveal rounded-2xl border border-zinc-200 p-6 dark:border-zinc-800">
            <h3 class="font-mono text-sm text-zinc-500">{group.group}</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full bg-zinc-100 px-3 py-1.5 text-sm text-zinc-700 dark:bg-zinc-900 dark:text-zinc-300">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
