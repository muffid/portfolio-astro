---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';
---

<section id="experience" class="border-t border-zinc-200 py-24 dark:border-zinc-900">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading index="04" title="Pengalaman" />

    <ol class="relative space-y-12 border-l border-zinc-200 pl-8 dark:border-zinc-800">
      {
        experience.map((job) => (
          <li class="reveal relative">
            <span
              aria-hidden="true"
              class="absolute top-1.5 -left-[37px] size-2.5 rounded-full border-2 border-accent bg-white dark:border-accent-dark dark:bg-zinc-950"
            />
            <p class="font-mono text-xs text-zinc-500">{job.period}</p>
            <h3 class="mt-1 text-lg font-semibold text-zinc-900 dark:text-zinc-50">
              {job.role} <span class="font-normal text-zinc-500">· {job.company}</span>
            </h3>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {job.points.map((pt) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="text-zinc-400">–</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
