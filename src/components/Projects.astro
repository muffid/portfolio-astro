---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';
---

<section id="projects" class="border-t border-zinc-200 py-24 dark:border-zinc-900">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading index="03" title="Proyek pilihan" />

    <div class="grid gap-6 sm:grid-cols-2">
      {
        projects.map((p, i) => (
          <article class="reveal group flex flex-col rounded-2xl border border-zinc-200 p-6 transition hover:-translate-y-1 hover:border-zinc-400 hover:shadow-lg hover:shadow-zinc-200/60 dark:border-zinc-800 dark:hover:border-zinc-600 dark:hover:shadow-none">
            <div class="flex items-start justify-between">
              <span class="font-mono text-xs text-zinc-400">{String(i + 1).padStart(2, '0')}</span>
              <span
                aria-hidden="true"
                class="text-zinc-400 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent dark:group-hover:text-accent-dark"
              >
                ↗
              </span>
            </div>

            <h3 class="mt-6 text-xl font-semibold text-zinc-900 dark:text-zinc-50">{p.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {p.description}
            </p>

            <ul class="mt-6 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <li class="font-mono text-xs text-accent dark:text-accent-dark">#{t}</li>
              ))}
            </ul>

            <div class="mt-6 flex gap-5 border-t border-zinc-100 pt-4 text-sm dark:border-zinc-900">
              <a href={p.demo} class="font-medium text-zinc-900 hover:underline dark:text-zinc-100">
                Demo
              </a>
              <a href={p.repo} class="text-zinc-500 hover:text-zinc-900 hover:underline dark:hover:text-zinc-100">
                Kode
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
