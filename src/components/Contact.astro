---
import SectionHeading from './SectionHeading.astro';
import { profile, socials } from '../data/site';
---

<section id="contact" class="border-t border-zinc-200 py-24 dark:border-zinc-900">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading index="05" title="Mari bekerja sama" />

    <div class="grid gap-12 md:grid-cols-2">
      <div class="reveal">
        <p class="max-w-md leading-relaxed text-zinc-600 dark:text-zinc-400">
          Punya ide, proyek, atau sekadar ingin menyapa? Kirim pesan dan saya akan membalas secepatnya.
        </p>
        <a
          href={`mailto:${profile.email}`}
          class="mt-6 inline-block text-2xl font-semibold tracking-tight text-zinc-900 underline decoration-zinc-300 underline-offset-8 transition hover:decoration-accent dark:text-zinc-50 dark:decoration-zinc-700 dark:hover:decoration-accent-dark"
        >
          {profile.email}
        </a>
        <ul class="mt-8 flex flex-wrap gap-5 text-sm text-zinc-500">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-zinc-900 hover:underline dark:hover:text-zinc-100"
                >
                  {s.name} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Form membuka aplikasi email (tanpa backend). Ganti action ke Formspree/Netlify Forms bila perlu. -->
      <form id="contact-form" class="reveal space-y-4">
        <div>
          <label for="name" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Nama</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-xl border border-zinc-300 bg-transparent px-4 py-3 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-emerald-500/20 dark:border-zinc-700 dark:focus:border-accent-dark"
          />
        </div>
        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Pesan</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full resize-none rounded-xl border border-zinc-300 bg-transparent px-4 py-3 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-emerald-500/20 dark:border-zinc-700 dark:focus:border-accent-dark"
          ></textarea>
        </div>
        <button
          type="submit"
          class="rounded-full bg-zinc-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
        >
          Kirim pesan
        </button>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ email: profile.email }}>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const subject = encodeURIComponent(`Pesan dari ${fd.get('name')}`);
    const body = encodeURIComponent(String(fd.get('message')));
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
